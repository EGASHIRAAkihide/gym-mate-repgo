{
  "color": {
    "brand": {
      "primary": { "value": "#1C2E4A" },
      "secondary": { "value": "#4F7FFF" }
    },
    "semantic": {
      "success": { "value": "#22C55E" },
      "warning": { "value": "#F59E0B" },
      "error":   { "value": "#EF4444" },
      "info":    { "value": "#3B82F6" }
    },
    "neutral": {
      "0":   { "value": "#FFFFFF" },
      "50":  { "value": "#F8FAFC" },
      "100": { "value": "#F1F5F9" },
      "200": { "value": "#E2E8F0" },
      "300": { "value": "#CBD5E1" },
      "400": { "value": "#94A3B8" },
      "500": { "value": "#64748B" },
      "600": { "value": "#475569" },
      "700": { "value": "#334155" },
      "800": { "value": "#1F2937" },
      "900": { "value": "#0B1220" }
    },
    "background": {
      "default":  { "value": "{color.neutral.0.value}" },
      "surface":  { "value": "{color.neutral.50.value}" },
      "elevated": { "value": "{color.neutral.100.value}" }
    },
    "text": {
      "primary":   { "value": "{color.neutral.900.value}" },
      "secondary": { "value": "{color.neutral.600.value}" },
      "inverse":   { "value": "{color.neutral.0.value}" },
      "link":      { "value": "{color.brand.secondary.value}" }
    },
    "border": {
      "subtle": { "value": "{color.neutral.200.value}" },
      "strong": { "value": "{color.neutral.300.value}" }
    }
  },

  "typography": {
    "fontFamily": {
      "sans": { "value": "Inter, 'Noto Sans JP', system-ui, -apple-system, Roboto" }
    },
    "heading": {
      "1": {
        "fontFamily": { "value": "{typography.fontFamily.sans.value}" },
        "fontWeight": { "value": "700" },
        "fontSize":   { "value": "32" },
        "lineHeight": { "value": "1.25" }
      },
      "2": {
        "fontFamily": { "value": "{typography.fontFamily.sans.value}" },
        "fontWeight": { "value": "600" },
        "fontSize":   { "value": "24" },
        "lineHeight": { "value": "1.30" }
      },
      "3": {
        "fontFamily": { "value": "{typography.fontFamily.sans.value}" },
        "fontWeight": { "value": "600" },
        "fontSize":   { "value": "20" },
        "lineHeight": { "value": "1.35" }
      }
    },
    "body": {
      "lg": {
        "fontFamily": { "value": "{typography.fontFamily.sans.value}" },
        "fontWeight": { "value": "400" },
        "fontSize":   { "value": "18" },
        "lineHeight": { "value": "1.55" }
      },
      "md": {
        "fontFamily": { "value": "{typography.fontFamily.sans.value}" },
        "fontWeight": { "value": "400" },
        "fontSize":   { "value": "16" },
        "lineHeight": { "value": "1.50" }
      },
      "sm": {
        "fontFamily": { "value": "{typography.fontFamily.sans.value}" },
        "fontWeight": { "value": "400" },
        "fontSize":   { "value": "14" },
        "lineHeight": { "value": "1.45" }
      }
    },
    "caption": {
      "default": {
        "fontFamily": { "value": "{typography.fontFamily.sans.value}" },
        "fontWeight": { "value": "400" },
        "fontSize":   { "value": "12" },
        "lineHeight": { "value": "1.40" }
      }
    }
  },

  "space": {
    "1":  { "value": "4" },
    "2":  { "value": "8" },
    "3":  { "value": "12" },
    "4":  { "value": "16" },
    "5":  { "value": "20" },
    "6":  { "value": "24" },
    "8":  { "value": "32" },
    "10": { "value": "40" },
    "12": { "value": "48" },
    "16": { "value": "64" }
  },

  "radius": {
    "s":    { "value": "4" },
    "m":    { "value": "8" },
    "xl":   { "value": "16" },
    "2xl":  { "value": "24" },
    "full": { "value": "999" }
  },

  "elevation": {
    "1": {
      "value": [
        { "color": "#00000024", "type": "dropShadow", "x": "0", "y": "1", "blur": "2", "spread": "0" }
      ]
    },
    "2": {
      "value": [
        { "color": "#0000001F", "type": "dropShadow", "x": "0", "y": "2", "blur": "4", "spread": "0" }
      ]
    },
    "3": {
      "value": [
        { "color": "#00000029", "type": "dropShadow", "x": "0", "y": "4", "blur": "12", "spread": "0" }
      ]
    },
    "4": {
      "value": [
        { "color": "#00000033", "type": "dropShadow", "x": "0", "y": "8", "blur": "24", "spread": "0" }
      ]
    }
  },

  "button": {
    "radius": { "value": "{radius.xl.value}" },
    "padding": {
      "x": { "value": "{space.4.value}" },
      "y": { "value": "{space.3.value}" }
    },
    "primary": {
      "background": { "value": "{color.brand.primary.value}" },
      "foreground": { "value": "{color.text.inverse.value}" },
      "border":     { "value": "transparent" }
    },
    "secondary": {
      "background": { "value": "{color.brand.secondary.value}" },
      "foreground": { "value": "{color.text.inverse.value}" },
      "border":     { "value": "transparent" }
    },
    "ghost": {
      "background": { "value": "transparent" },
      "foreground": { "value": "{color.text.primary.value}" },
      "border":     { "value": "{color.border.subtle.value}" }
    },
    "disabled": {
      "background": { "value": "{color.neutral.200.value}" },
      "foreground": { "value": "{color.neutral.500.value}" },
      "border":     { "value": "transparent" }
    }
  },

  "input": {
    "background": { "value": "{color.background.surface.value}" },
    "border": {
      "default": { "value": "{color.border.subtle.value}" },
      "focus":   { "value": "{color.brand.secondary.value}" },
      "error":   { "value": "{color.semantic.error.value}" }
    },
    "text": {
      "default":      { "value": "{color.text.primary.value}" },
      "placeholder":  { "value": "{color.text.secondary.value}" },
      "error":        { "value": "{color.semantic.error.value}" }
    },
    "radius": { "value": "{radius.m.value}" },
    "padding": {
      "x": { "value": "{space.3.value}" },
      "y": { "value": "{space.2.value}" }
    },
    "label": {
      "fontSize":   { "value": "{typography.caption.default.fontSize.value}" },
      "fontWeight": { "value": "{typography.caption.default.fontWeight.value}" },
      "lineHeight": { "value": "{typography.caption.default.lineHeight.value}" }
    },
    "helper": {
      "fontSize":   { "value": "{typography.caption.default.fontSize.value}" },
      "fontWeight": { "value": "{typography.caption.default.fontWeight.value}" },
      "lineHeight": { "value": "{typography.caption.default.lineHeight.value}" },
      "color":      { "value": "{color.text.secondary.value}" }
    }
  },

  "avatar": {
    "background": { "value": "{color.neutral.200.value}" },
    "text":       { "value": "{color.text.inverse.value}" },
    "border": {
      "default": { "value": "{color.border.strong.value}" },
      "online":  { "value": "{color.semantic.success.value}" },
      "offline": { "value": "{color.neutral.400.value}" }
    },
    "size": {
      "sm": { "value": "32" },
      "md": { "value": "48" },
      "lg": { "value": "64" }
    },
    "radius": { "value": "{radius.full.value}" },
    "statusDot": {
      "size":   { "value": "8" },
      "offset": { "value": "2" }
    }
  },

  "card": {
    "background": {
      "default":  { "value": "{color.background.surface.value}" },
      "elevated": { "value": "{color.background.elevated.value}" }
    },
    "border": {
      "default":  { "value": "{color.border.subtle.value}" },
      "emphasis": { "value": "{color.brand.secondary.value}" },
      "warning":  { "value": "{color.semantic.warning.value}" }
    },
    "radius": { "value": "{radius.xl.value}" },
    "padding": {
      "x": { "value": "{space.4.value}" },
      "y": { "value": "{space.3.value}" }
    },
    "gap": { "value": "{space.2.value}" }
  }
}