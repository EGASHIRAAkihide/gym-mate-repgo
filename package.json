{
  "scripts": {
    "tokens:build": "pnpm exec style-dictionary build --config design/style-dictionary/config.json",
    "tokens:dart": "pnpm exec ts-node scripts/generate-dart-tokens.ts",
    "tokens": "pnpm run tokens:build && pnpm run tokens:dart",
    "codex": "pnpm exec ts-node scripts/codex-run.ts",
    "codex:task": "pnpm exec ts-node scripts/codex-run.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "style-dictionary": "^4.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}